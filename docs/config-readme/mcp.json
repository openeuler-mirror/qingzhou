{                                   // 本文件为填写示例，运行时实际读取实例目录下的 conf/mcp.json；
  "mcpServers": {                       // 顶层键 mcpServers 固定，其下每个子键为 server-id（决定技能名与工具名前缀 mcp__<id>__）
    "demo-server": {                        // 示例 server；整段复制并改 server-id 即可新增，不用的示例可直接删除
      "enabled": true,                          // 可选；默认启用
      "url": "http://127.0.0.1:8080/mcp",       // 必填；MCP Server 的 http 接入地址
      "description": "示例 MCP Server",          // 可选；作为技能描述优先取值，留空回退 MCP Server 自报描述
      "headers": {                              // 可选；随每个请求发送的请求头
        "Authorization": "plain: Bearer token"  // 值支持密文（解密密钥 mcp.headers）；plain: 前缀表示明文
      }
    }
  }
}
